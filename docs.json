{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Teralis",
  "colors": {
    "primary": "#0369A1",
    "light": "#0EA5E9",
    "dark": "#075985"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.png",
  "navigation": {
